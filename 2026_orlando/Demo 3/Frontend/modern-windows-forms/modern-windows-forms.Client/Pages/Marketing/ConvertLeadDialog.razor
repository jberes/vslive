@using modern_windows_forms.Client.Models.Marketing

@* "Convert to customer": POST /api/leads/{id}/convert, then PUT /api/customers/{id} if the user edited the prefilled fields. *@
<div class="convert-host">
<IgbDialog @ref="dialog" class="convert-dialog" HideDefaultAction="true" KeepOpenOnEscape="false" CloseOnOutsideClick="false"
           Closed="OnClosed" aria-labelledby="convert-title">
    @if (lead is not null)
    {
        <div class="head">
            <span class="head__tile" aria-hidden="true"><IgbIcon IconName="user-plus" Collection="@Icons.Collection" /></span>
            <div class="head__text">
                <h2 id="convert-title" class="head__title">Convert to customer</h2>
                <p class="head__lede">@lead.FullName moves to Won and a Sales customer is created.</p>
            </div>
            <IgbIconButton class="head__close" IconName="x" Collection="@Icons.Collection" Variant="IconButtonVariant.Flat"
                           aria-label="Close" @onclick="CancelAsync" />
        </div>

        <div class="form">
            @if (problem is not null)
            {
                <div class="banner banner--error span-2" role="alert">
                    <span><strong>@problem.Title</strong> @problem.Detail</span>
                </div>
            }
            <IgbInput class="span-2" Label="Company name" Outlined="true" @bind-Value="companyName" Required="true"
                      Invalid="@(string.IsNullOrWhiteSpace(companyName) || problem?.ErrorFor("CompanyName") is not null)">
                @if (problem?.ErrorFor("CompanyName") is { } companyError)
                {
                    <span slot="helper-text">@companyError</span>
                }
            </IgbInput>
            <IgbInput class="code-input" Label="Customer code" Outlined="true" @bind-Value="code" Placeholder="Auto"
                      Invalid="@(problem?.ErrorFor("Code") is not null)">
                <span slot="helper-text">@(problem?.ErrorFor("Code") ?? "Generated by the API if left blank")</span>
            </IgbInput>
            <IgbSelect Label="Country" Outlined="true" @bind-Value="country">
                @foreach (var c in countryOptions)
                {
                    <IgbSelectItem Value="@c">@c</IgbSelectItem>
                }
            </IgbSelect>
            <IgbInput Label="Contact" Outlined="true" @bind-Value="contactName" />
            <IgbInput Label="Contact title" Outlined="true" @bind-Value="contactTitle" />
            <IgbCheckbox class="span-2" @bind-Checked="keepOwner">Keep @(lead.OwnerName ?? "the current owner") as account owner</IgbCheckbox>
            <div class="note span-2">
                <IgbIcon IconName="info" Collection="@Icons.Collection" aria-hidden="true" />
                <span>Estimated value @Format.Money0(lead.EstimatedValue) stays on the lead for campaign ROI.</span>
            </div>
        </div>
    }
    <IgbButton slot="footer" Variant="ButtonVariant.Outlined" @onclick="CancelAsync" Disabled="@busy">Cancel</IgbButton>
    <IgbButton slot="footer" Variant="ButtonVariant.Contained" @onclick="ConvertAsync" Disabled="@(busy || string.IsNullOrWhiteSpace(companyName))">
        @(busy ? "Converting…" : "Convert")
    </IgbButton>
</IgbDialog>
</div>
